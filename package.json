{
  "name": "pi-delegateau",
  "version": "0.1.0",
  "description": "Standalone Pi extension for bounded, model-routed delegation",
  "type": "module",
  "license": "MIT",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./src/*": "./src/*"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "delegation",
    "jev"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run build && npm test"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@typesafe-ai/sdk": ">=0.6.0 <0.7.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.85.1 <0.86.0",
    "typebox": ">=1.3.27 <1.4.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.85.1 <0.86.0",
    "@types/node": ">=22.19.19 <23.0.0",
    "typebox": ">=1.3.27 <1.4.0",
    "typescript": ">=5.9.3 <5.10.0",
    "vitest": ">=4.1.9 <4.2.0"
  }
}
